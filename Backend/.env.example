# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# From the Plaid dashboard (dashboard.plaid.com/team/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | development | production
PLAID_ENV=sandbox

# Must exactly match an entry in the Plaid dashboard's Allowed redirect URIs
# (Team Settings > API). Required because MACU uses OAuth.
PLAID_REDIRECT_URI=

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

PORT=4001
